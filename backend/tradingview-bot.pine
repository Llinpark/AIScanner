//@version=6
// UNUSED ARCHIVE — Classic FVG/Breakaway reference only.
// Production scripts are generated from:
//   templates/kaching-sweep-fvg-daytrading.pine.template
//   templates/kaching-sweep-fvg-scalp.pine.template
//   templates/snippets/kaching-trade-drawing.pine.snippet
// Pine rule: never reassign global scalars inside functions. Use a main-scope
// state machine for tradeState/lineAge and keep drawings in mutable arrays.
indicator("KachingFx Structural Scanner", overlay=true, max_labels_count=50, max_lines_count=500, max_boxes_count=50)

// ===== CONFIGURATION =====
WEBHOOK_URL = input.string("https://api.kachingscanner.com/api/webhook/tradingview", "Webhook URL", group="KachingFx")
WEBHOOK_SECRET = input.string("your_webhook_secret", "Webhook Secret", group="KachingFx")
SEND_CANDLE_FEED = input.bool(true, "Send each bar to server scanner", group="KachingFx")
SHOW_TRADE_LINES = true
SHOW_FVG_ZONE = input.bool(false, "Shade the fair value gap zone", group="KachingFx")
levelExtendBars = input.int(22, "Trade level length (bars)", minval=15, maxval=30, group="KachingFx Display")
tradeMaxAgeBars = input.int(80, "Trade overlay expiry (bars)", minval=20, maxval=300, group="KachingFx Display")

minBodyRatio = input.float(0.62, "Perfect FVG: min C2 body/range", minval=0.4, maxval=0.95, group="Pattern A — FVG")
maxWickRatio = input.float(0.28, "Perfect FVG: max C2 wick/range", minval=0.05, maxval=0.5, group="Pattern A — FVG")
volMult = input.float(1.15, "Perfect FVG: volume multiplier", minval=1.0, maxval=3.0, group="Pattern A — FVG")

c1DispBody = input.float(0.55, "Breakaway: C1 min body/range", minval=0.35, maxval=0.95, group="Pattern B — Breakaway")
minGapRatio = input.float(0.08, "Breakaway: min gap / C1 range", minval=0.02, maxval=0.5, group="Pattern B — Breakaway")

slPips = input.int(30, "Kaching SL (pips)", minval=1, group="Risk")
tp1R = input.float(1.0, "Kaching TP1 (R)", group="Risk")
tp2R = input.float(2.0, "Kaching TP2 (R)", group="Risk")
tp3R = input.float(3.0, "Kaching TP3 (R)", group="Risk")

// ===== COLORS =====
colEntry = #38bdf8
colSl = #f87171
colTp1 = #4ade80
colTp2 = #22c55e
colTp3 = #fbbf24
colLongZoneBg = color.new(#4ade80, 85)
colLongZoneBorder = color.new(#4ade80, 30)
colShortZoneBg = color.new(#f87171, 85)
colShortZoneBorder = color.new(#f87171, 30)

// ===== HELPERS =====
bodyRatio(c) =>
    math.abs(c.close - c.open) / math.max(c.high - c.low, syminfo.mintick)

wickRatio(c) =>
    (c.high - math.max(c.open, c.close) + math.min(c.open, c.close) - c.low) / math.max(c.high - c.low, syminfo.mintick)

avgVol = ta.sma(volume, 20)
hasUsableVolume = not na(avgVol) and avgVol > 0
atr14 = ta.atr(14)

pointSize() =>
    tick = math.max(nz(syminfo.mintick, 0.0001), 1e-8)
    t = str.upper(syminfo.ticker)
    str.contains(t, "JPY") ? 0.01 :
     str.contains(t, "XAU") or str.contains(t, "UAX") or str.contains(t, "GOLD") ? 0.1 :
     str.contains(t, "XAG") or str.contains(t, "SILVER") ? 0.01 :
     close >= 1000 or tick >= 1.0 ? math.max(tick, 1.0) :
     close >= 50 ? math.max(tick, 0.1) :
     math.max(tick * 10, 0.0001)

fmtPx(float px) =>
    str.tostring(px, format.mintick)

kachingAlertLabel(string alertType) =>
    alertType == "entry" ? "Kaching Entry" :
     alertType == "stop_loss" ? "Kaching SL" :
     alertType == "take_profit_1" ? "Kaching TP1" :
     alertType == "take_profit_2" ? "Kaching TP2" :
     alertType == "take_profit_3" ? "Kaching TP3" :
     "Kaching Signal"

buildPayload(string alertType, string pattern, string direction, float entry, float sl, float tp1, float tp2, float tp3, float gapTop, float gapBot, float conf) =>
    '{"symbol":"' + syminfo.ticker + '","pattern":"' + pattern + '","alertType":"' + alertType + '","direction":"' + direction + '","entry":' + fmtPx(entry) + ',"stop_loss":' + fmtPx(sl) + ',"stop_loss_1":' + fmtPx(sl) + ',"take_profit_1":' + fmtPx(tp1) + ',"take_profit_2":' + fmtPx(tp2) + ',"take_profit_3":' + fmtPx(tp3) + ',"gapTop":' + fmtPx(gapTop) + ',"gapBottom":' + fmtPx(gapBot) + ',"confidence":' + str.tostring(conf, "#.##") + ',"open":' + fmtPx(open) + ',"high":' + fmtPx(high) + ',"low":' + fmtPx(low) + ',"close":' + fmtPx(close) + ',"volume":' + str.tostring(nz(volume, 0)) + ',"time":' + str.tostring(time) + ',"message":"' + kachingAlertLabel(alertType) + '","broadcast":true,"secret":"' + WEBHOOK_SECRET + '"}'

calcLevels(string direction, float entry, float gapTop, float gapBot) =>
    pip = pointSize()
    pipDist = slPips * pip
    atrFloor = nz(atr14, pipDist) * 0.35
    slDist = math.max(pipDist, atrFloor)
    sl = direction == "long" ? entry - slDist : entry + slDist
    risk = math.abs(entry - sl)
    tp1 = direction == "long" ? entry + risk * tp1R : entry - risk * tp1R
    tp2 = direction == "long" ? entry + risk * tp2R : entry - risk * tp2R
    tp3 = direction == "long" ? entry + risk * tp3R : entry - risk * tp3R
    [entry, sl, tp1, tp2, tp3, risk]

makeSignalId(string direction) =>
    str.tostring(time) + "_" + direction + "_" + str.tostring(bar_index)

// ===== TRADE STATE MACHINE (main-scope scalars only) =====
TRADE_IDLE = 0
TRADE_ACTIVE = 1

var array<line> tradeLevelLines = array.new_line()
var array<label> tradeLevelLabels = array.new_label()
var array<string> tradeLevelTags = array.new_string()
var array<label> tradeBadges = array.new_label()
var array<box> tradeZones = array.new_box()

var int tradeState = 0
var int lineAge = 0
var int signalBar = na
var string activeSignalId = na
var string activeDirection = na
var string activePattern = na
var float activeEntry = na
var float activeSl = na
var float activeTp1 = na
var float activeTp2 = na
var float activeTp3 = na
var float activeGapTop = na
var float activeGapBot = na
var bool tp1Done = false
var bool tp2Done = false

// Array/drawing mutation only — never reassign global scalars here.
clearTradeDrawings() =>
    if array.size(tradeLevelLines) > 0
        for i = 0 to array.size(tradeLevelLines) - 1
            line.delete(array.get(tradeLevelLines, i))
    if array.size(tradeLevelLabels) > 0
        for i = 0 to array.size(tradeLevelLabels) - 1
            label.delete(array.get(tradeLevelLabels, i))
    if array.size(tradeBadges) > 0
        for i = 0 to array.size(tradeBadges) - 1
            label.delete(array.get(tradeBadges, i))
    if array.size(tradeZones) > 0
        for i = 0 to array.size(tradeZones) - 1
            box.delete(array.get(tradeZones, i))
    array.clear(tradeLevelLines)
    array.clear(tradeLevelLabels)
    array.clear(tradeLevelTags)
    array.clear(tradeBadges)
    array.clear(tradeZones)

removeTradeLevelByTag(string tag) =>
    idx = array.indexof(tradeLevelTags, tag)
    if idx >= 0
        line.delete(array.get(tradeLevelLines, idx))
        label.delete(array.get(tradeLevelLabels, idx))
        array.remove(tradeLevelLines, idx)
        array.remove(tradeLevelLabels, idx)
        array.remove(tradeLevelTags, idx)

pushLevel(float price, string tag, color lineCol, color labelCol, color textCol) =>
    ln = line.new(bar_index, price, bar_index + 1, price, xloc=xloc.bar_index, extend=extend.none, color=lineCol, width=2, style=tag == "TP1" or tag == "TP2" or tag == "TP3" ? line.style_dashed : line.style_solid)
    lb = label.new(bar_index + 1, price, tag, style=label.style_label_left, color=labelCol, textcolor=textCol, size=size.small)
    array.push(tradeLevelLines, ln)
    array.push(tradeLevelLabels, lb)
    array.push(tradeLevelTags, tag)

paintTradeSet(float entryPrice, float slPrice, float tp1Price, float tp2Price, float tp3Price) =>
    pushLevel(entryPrice, "Entry", color.new(colEntry, 0), color.new(colEntry, 0), color.white)
    pushLevel(slPrice, "SL", color.new(colSl, 0), color.new(colSl, 0), color.white)
    pushLevel(tp1Price, "TP1", color.new(colTp1, 0), color.new(colTp1, 0), color.black)
    pushLevel(tp2Price, "TP2", color.new(colTp2, 0), color.new(colTp2, 0), color.white)
    pushLevel(tp3Price, "TP3", color.new(colTp3, 0), color.new(colTp3, 0), color.black)

armTradeDrawings(float ee, float ssl, float t1, float t2, float t3, bool isLong, float gapTop, float gapBot, color badgeCol, string badgeTip) =>
    clearTradeDrawings()
    badgeY = isLong ? low : high
    badgeTxt = isLong ? "BUY" : "SELL"
    badgeStyle = isLong ? label.style_label_up : label.style_label_down
    array.push(tradeBadges, label.new(bar_index, badgeY, badgeTxt, style=badgeStyle, color=badgeCol, textcolor=color.white, size=size.normal, tooltip=badgeTip))
    if SHOW_FVG_ZONE
        zoneBorder = isLong ? colLongZoneBorder : colShortZoneBorder
        zoneBg = isLong ? colLongZoneBg : colShortZoneBg
        array.push(tradeZones, box.new(bar_index - 2, math.max(gapTop, gapBot), bar_index + 5, math.min(gapTop, gapBot), border_color=zoneBorder, bgcolor=zoneBg))
    if SHOW_TRADE_LINES
        paintTradeSet(ee, ssl, t1, t2, t3)

extendTradeLines() =>
    if array.size(tradeLevelLines) > 0 and not na(signalBar)
        maxX = signalBar + levelExtendBars
        x2 = math.max(signalBar + 1, math.min(bar_index + 1, maxX))
        for i = 0 to array.size(tradeLevelLines) - 1
            ln = array.get(tradeLevelLines, i)
            if not na(ln)
                line.set_x2(ln, x2)
                lb = array.get(tradeLevelLabels, i)
                if not na(lb)
                    label.set_x(lb, x2)

// ===== PATTERN A: PERFECT FVG (C1,C2,C3) =====
c1o = open[2]
c1h = high[2]
c1l = low[2]
c1c = close[2]
c2o = open[1]
c2h = high[1]
c2l = low[1]
c2c = close[1]
c2v = volume[1]
c3h = high[0]
c3l = low[0]
c3c = close[0]

bullFVG = c1h < c3l
bearFVG = c1l > c3h

c2Range = math.max(c2h - c2l, syminfo.mintick)
c2Body = math.abs(c2c - c2o) / c2Range
c2Wick = (c2h - math.max(c2o, c2c) + math.min(c2o, c2c) - c2l) / c2Range
c2VolOk = not hasUsableVolume or (not na(c2v) and c2v >= avgVol[1] * volMult)
c2Bull = c2c >= c2o
gapSizeBull = math.abs(c3l - c1h)
gapSizeBear = math.abs(c1l - c3h)
minGapAbs = math.max(nz(atr14, syminfo.mintick) * 0.12, syminfo.mintick * 10)
gapOkBull = gapSizeBull >= minGapAbs
gapOkBear = gapSizeBear >= minGapAbs

perfectBullFVG = bullFVG and gapOkBull and c2Body >= minBodyRatio and c2Wick <= maxWickRatio and c2VolOk and c2Bull and barstate.isconfirmed
perfectBearFVG = bearFVG and gapOkBear and c2Body >= minBodyRatio and c2Wick <= maxWickRatio and c2VolOk and not c2Bull and barstate.isconfirmed

gapTopBull = c3l
gapBotBull = c1h
gapTopBear = c1l
gapBotBear = c3h

// ===== PATTERN B: BREAKAWAY GAP =====
c1Body = math.abs(c1c - c1o) / math.max(c1h - c1l, syminfo.mintick)
c1Range = math.max(c1h - c1l, syminfo.mintick)

c2Open = c2o
bullBreakSetup = c1Body >= c1DispBody and c2Open > c1h and c2l > c1h
bearBreakSetup = c1Body >= c1DispBody and c2Open < c1l and c2h < c1l

bullGapSize = c2l - c1h
bearGapSize = c1l - c2h
bullBreakSetup := bullBreakSetup and bullGapSize / c1Range >= minGapRatio
bearBreakSetup := bearBreakSetup and bearGapSize / c1Range >= minGapRatio

bullBreakConfirm = bullBreakSetup and c3c > c2Open and c3c > c1h and c3c >= open and barstate.isconfirmed
bearBreakConfirm = bearBreakSetup and c3c < c2Open and c3c < c1l and c3c <= open and barstate.isconfirmed

// ===== TRADE LIFECYCLE (main scope) =====
newTradeState = tradeState
newLineAge = lineAge
newTp1Done = tp1Done
newTp2Done = tp2Done
clearActiveScalars = false

if tradeState == TRADE_ACTIVE and barstate.isconfirmed
    newLineAge += 1
    extendTradeLines()
    longTrade = activeDirection == "long"
    hitSl = longTrade ? low <= activeSl : high >= activeSl
    hitTp1 = not tp1Done and not na(activeTp1) and (longTrade ? high >= activeTp1 : low <= activeTp1)
    hitTp2 = not tp2Done and not na(activeTp2) and (longTrade ? high >= activeTp2 : low <= activeTp2)
    hitTp3 = not na(activeTp3) and (longTrade ? high >= activeTp3 : low <= activeTp3)
    expired = newLineAge >= tradeMaxAgeBars

    if hitSl
        alert(buildPayload("stop_loss", activePattern, activeDirection, activeEntry, activeSl, activeTp1, activeTp2, activeTp3, activeGapTop, activeGapBot, 0.0), alert.freq_once_per_bar)
        clearTradeDrawings()
        newTradeState := TRADE_IDLE
        newLineAge := 0
        newTp1Done := false
        newTp2Done := false
        clearActiveScalars := true
    else
        if hitTp1
            newTp1Done := true
            removeTradeLevelByTag("TP1")
            alert(buildPayload("take_profit_1", activePattern, activeDirection, activeEntry, activeSl, activeTp1, activeTp2, activeTp3, activeGapTop, activeGapBot, 0.0), alert.freq_once_per_bar)
        if hitTp2
            newTp2Done := true
            removeTradeLevelByTag("TP2")
            alert(buildPayload("take_profit_2", activePattern, activeDirection, activeEntry, activeSl, activeTp1, activeTp2, activeTp3, activeGapTop, activeGapBot, 0.0), alert.freq_once_per_bar)
        if hitTp3
            removeTradeLevelByTag("TP3")
            alert(buildPayload("take_profit_3", activePattern, activeDirection, activeEntry, activeSl, activeTp1, activeTp2, activeTp3, activeGapTop, activeGapBot, 0.0), alert.freq_once_per_bar)
            clearTradeDrawings()
            newTradeState := TRADE_IDLE
            newLineAge := 0
            newTp1Done := false
            newTp2Done := false
            clearActiveScalars := true
        else if expired
            clearTradeDrawings()
            newTradeState := TRADE_IDLE
            newLineAge := 0
            newTp1Done := false
            newTp2Done := false
            clearActiveScalars := true

tradeState := newTradeState
lineAge := newLineAge
tp1Done := newTp1Done
tp2Done := newTp2Done

if clearActiveScalars
    signalBar := na
    activeSignalId := na
    activeDirection := na
    activePattern := na
    activeEntry := na
    activeSl := na
    activeTp1 := na
    activeTp2 := na
    activeTp3 := na
    activeGapTop := na
    activeGapBot := na

// ===== FIRE ENTRY ALERTS (scalar assigns stay in main scope) =====
if perfectBullFVG
    [e, sl, t1, t2, t3, _] = calcLevels("long", close, gapTopBull, gapBotBull)
    msg = buildPayload("entry", "perfect_fvg", "long", e, sl, t1, t2, t3, gapTopBull, gapBotBull, 0.88)
    alert(msg, alert.freq_once_per_bar)
    armTradeDrawings(e, sl, t1, t2, t3, true, gapTopBull, gapBotBull, color.new(color.green, 0), "Perfect FVG — long")
    tradeState := TRADE_ACTIVE
    lineAge := 0
    signalBar := bar_index
    activeSignalId := makeSignalId("long")
    activeDirection := "long"
    activePattern := "perfect_fvg"
    activeEntry := e
    activeSl := sl
    activeTp1 := t1
    activeTp2 := t2
    activeTp3 := t3
    activeGapTop := gapTopBull
    activeGapBot := gapBotBull
    tp1Done := false
    tp2Done := false

if perfectBearFVG
    [e, sl, t1, t2, t3, _] = calcLevels("short", close, gapTopBear, gapBotBear)
    msg = buildPayload("entry", "perfect_fvg", "short", e, sl, t1, t2, t3, gapTopBear, gapBotBear, 0.88)
    alert(msg, alert.freq_once_per_bar)
    armTradeDrawings(e, sl, t1, t2, t3, false, gapTopBear, gapBotBear, color.new(color.red, 0), "Perfect FVG — short")
    tradeState := TRADE_ACTIVE
    lineAge := 0
    signalBar := bar_index
    activeSignalId := makeSignalId("short")
    activeDirection := "short"
    activePattern := "perfect_fvg"
    activeEntry := e
    activeSl := sl
    activeTp1 := t1
    activeTp2 := t2
    activeTp3 := t3
    activeGapTop := gapTopBear
    activeGapBot := gapBotBear
    tp1Done := false
    tp2Done := false

if bullBreakConfirm
    [e, sl, t1, t2, t3, _] = calcLevels("long", close, math.max(c2Open, c3h), c1h)
    msg = buildPayload("entry", "breakaway_gap", "long", e, sl, t1, t2, t3, math.max(c2Open, c3h), c1h, 0.82)
    alert(msg, alert.freq_once_per_bar)
    armTradeDrawings(e, sl, t1, t2, t3, true, math.max(c2Open, c3h), c1h, color.new(color.blue, 0), "Breakaway gap — long")
    tradeState := TRADE_ACTIVE
    lineAge := 0
    signalBar := bar_index
    activeSignalId := makeSignalId("long")
    activeDirection := "long"
    activePattern := "breakaway_gap"
    activeEntry := e
    activeSl := sl
    activeTp1 := t1
    activeTp2 := t2
    activeTp3 := t3
    activeGapTop := math.max(c2Open, c3h)
    activeGapBot := c1h
    tp1Done := false
    tp2Done := false

if bearBreakConfirm
    [e, sl, t1, t2, t3, _] = calcLevels("short", close, c1l, math.min(c2Open, c3l))
    msg = buildPayload("entry", "breakaway_gap", "short", e, sl, t1, t2, t3, c1l, math.min(c2Open, c3l), 0.82)
    alert(msg, alert.freq_once_per_bar)
    armTradeDrawings(e, sl, t1, t2, t3, false, c1l, math.min(c2Open, c3l), color.new(color.orange, 0), "Breakaway gap — short")
    tradeState := TRADE_ACTIVE
    lineAge := 0
    signalBar := bar_index
    activeSignalId := makeSignalId("short")
    activeDirection := "short"
    activePattern := "breakaway_gap"
    activeEntry := e
    activeSl := sl
    activeTp1 := t1
    activeTp2 := t2
    activeTp3 := t3
    activeGapTop := c1l
    activeGapBot := math.min(c2Open, c3l)
    tp1Done := false
    tp2Done := false

// Feed each closed bar to backend scanner
if SEND_CANDLE_FEED and barstate.isconfirmed
    feedMsg = '{"symbol":"' + syminfo.ticker + '","alertType":"candle","pattern":"feed","open":' + str.tostring(open, "#.#####") + ',"high":' + str.tostring(high, "#.#####") + ',"low":' + str.tostring(low, "#.#####") + ',"close":' + str.tostring(close, "#.#####") + ',"volume":' + str.tostring(volume) + ',"time":' + str.tostring(time) + ',"secret":"' + WEBHOOK_SECRET + '"}'
    alert(feedMsg, alert.freq_once_per_bar)
