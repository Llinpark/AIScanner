//@version=5
indicator("{{INDICATOR_TITLE}}", shorttitle="{{INDICATOR_SHORTTITLE}}", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// Generated for: {{SUBSCRIBER_LABEL}}
// Tier: {{SUBSCRIPTION_TIER}} | Script ID: {{SCRIPT_ID}}
// Strategy: Liquidity Sweep + Fair Value Gap (Scalping)
// TF architecture (from Strategy Configuration): entry = {{ARCH_ENTRY_LABEL}}; HTF = {{ARCH_HTF_LABEL}} via request.security() only.
// Never require opening an HTF chart for entries; never fire entries on HTF candles.
// TradingView overlays show ONLY: Kaching Buy/Sell, Entry, SL, TP1–3 (with prices).

// ===== CONFIGURATION =====
// License is HMAC-bound to this TradingView username (server-side). Pine cannot read the
// current TV account at runtime, so CONFIRM is prefilled to the licensed username (override allowed).
WEBHOOK_URL = "{{WEBHOOK_URL}}"
LICENSE_TOKEN = "{{LICENSE_TOKEN}}"
LICENSED_TV_USERNAME = "{{TV_USERNAME}}"
CONFIRM_TV_USERNAME = input.string("{{TV_USERNAME}}", "Confirm your TradingView username", group="KachingFx License", tooltip="Prefilled with the username this script was licensed for. Leave as-is to unlock, or override if needed. Signals and alerts stay locked until it matches.")
SHOW_TRADE_LINES = true
SHOW_FVG_ZONE = input.bool(false, "Shade the fair value gap zone", group="KachingFx")
DEBUG_MODE = input.bool(false, "DEBUG_MODE — show block reasons", group="KachingFx", tooltip="When ON: on-chart labels + Pine Logs show skip reasons and full gate state (chart/entry/HTF TF, confidence, licenseOk, entryTfOk, htfTfOk, tradeActive, confirmed, fireLong/Short). Does NOT change when alert() fires. Turn OFF for live trading.")
levelExtendBars = input.int(22, "Initial trade level length (bars)", minval=8, maxval=60, group="KachingFx Display", tooltip="Starting length of Entry/SL/TP lines. While a trade is active, lines keep extending with each new candle until TP3/SL/expiry/cancel.")
enableTradeExpiry = input.bool(true, "Enable trade candle expiry", group="KachingFx Display", tooltip="When ON, active trades auto-close after expiryBars if TP3/SL not hit. When OFF, trades stay until TP3/SL/cancel only. Never clears because a later scan finds no setup.")
expiryBars = input.int(60, "Active trade expiry (candles)", minval=5, maxval=500, group="KachingFx Display", tooltip="Close and remove the active trade after this many candles if TP3/SL not hit (only when Enable trade candle expiry is ON). Default 60 for scalping so trades are not wiped after a few moments.")
smartLabelMinVerticalTicks = input.int(12, "Smart label min vertical gap (ticks)", minval=2, maxval=250, group="KachingFx Display", tooltip="Minimum price-space gap between trade labels before lower-priority labels are shifted.")
minHorizontalGapBars = input.int(2, "Smart label min horizontal gap (bars)", minval=1, maxval=8, group="KachingFx Display", tooltip="Horizontal spacing used for staggered smart labels and left/right spillover.")

htfTf = input.timeframe("{{HTF_TF}}", "{{HTF_INPUT_LABEL}}", group="Scalp — Structure", tooltip="{{HTF_INPUT_TOOLTIP}}")
swingLen = input.int({{SWING_SENSITIVITY}}, "Swing sensitivity", minval=1, maxval=5, group="Scalp — Structure")
eqTolAtr = input.float({{EQH_EQL_TOLERANCE}}, "EQH/EQL ATR tolerance", minval=0.01, maxval=0.5, group="Scalp — Structure")

minBodyRatio = input.float({{MIN_BODY_RATIO}}, "Displacement min body/range", minval=0.4, maxval=0.95, group="Scalp — Displacement")
maxWickRatio = input.float({{MAX_WICK_RATIO}}, "Displacement max wick/range", minval=0.05, maxval=0.5, group="Scalp — Displacement")
minDispAtr = input.float({{DISP_ATR_MULT}}, "Displacement min range/ATR", minval=0.5, maxval=3.0, group="Scalp — Displacement")

minGapAtr = input.float({{MIN_FVG_ATR}}, "Min FVG / ATR", minval=0.05, maxval=1.0, group="Scalp — FVG")
entryModel = input.string("{{ENTRY_MODEL}}", "Entry model", options=["ce", "entire", "upper_half", "lower_half"], group="Scalp — Entry")
stopModel = input.string("{{STOP_MODEL}}", "Stop model", options=["sweep", "fvg", "sweep_or_fvg"], group="Scalp — Risk")
tp1R = input.float({{TP1_R}}, "Kaching TP1 (R)", group="Scalp — Risk")
tp2R = input.float({{TP2_R}}, "Kaching TP2 (R)", group="Scalp — Risk")
tp3R = input.float({{TP3_R}}, "Kaching TP3 (R)", group="Scalp — Risk")
enableDynamicTp = input.bool({{ENABLE_DYNAMIC_TP}}, "Enable dynamic TP (ATR caps)", group="Scalp — Risk")
tp1AtrCap = input.float({{TP1_ATR_CAP}}, "TP1 max ATR", minval=0.1, group="Scalp — Risk")
tp2AtrCap = input.float({{TP2_ATR_CAP}}, "TP2 max ATR", minval=0.1, group="Scalp — Risk")
tp3AtrCap = input.float({{TP3_ATR_CAP}}, "TP3 max ATR", minval=0.1, group="Scalp — Risk")
confThreshold = input.float({{CONFIDENCE_THRESHOLD}}, "Min confidence (0-100)", minval=50, maxval=100, group="Scalp — Filters")
requireEngulf = input.bool({{REQUIRE_ENGULFING}}, "Require engulfing", group="Scalp — Filters")

normalizeTvUser(string s) =>
    str.lower(str.replace_all(str.trim(s), "@", ""))

licenseOk = str.length(LICENSED_TV_USERNAME) > 0 and normalizeTvUser(CONFIRM_TV_USERNAME) == LICENSED_TV_USERNAME

// ===== TIMEFRAME VALIDATION (from Strategy Configuration — Scalping) =====
// Entry-chart allowlist and HTF confirmation are injected from backend Strategy Configuration.
STRATEGY_KEY = "{{STRATEGY_KEY}}"
strategyCfgOk = STRATEGY_KEY == "scalping"
// Permitted entry charts only — signals never fire on HTF candles.
entryChartOk = {{ENTRY_CHART_OK}}
// Required HTF (seconds). Default baked from Strategy Configuration; advanced users may change input.
htfSec = timeframe.in_seconds(htfTf)
htfConfigured = htfSec > 0
htfTfOk = {{HTF_TF_OK}}
// Chart must be an entry TF; HTF is never a valid entry chart.
chartSec = timeframe.in_seconds()
chartIsHtf = htfConfigured and chartSec == htfSec
entryTfOk = strategyCfgOk and entryChartOk and htfConfigured and htfTfOk and not chartIsHtf

// Any TradingView instrument is valid — chart OHLC is the source of truth (no symbol allowlist).
var label licenseLockLabel = na
var label tfLockLabel = na
var label debugBlockLabel = na
if barstate.islast
    if not licenseOk
        if na(licenseLockLabel)
            licenseLockLabel := label.new(bar_index, high, "KachingFx: enter licensed TradingView username to unlock", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.normal)
        else
            label.set_xy(licenseLockLabel, bar_index, high)
    else if not na(licenseLockLabel)
        label.delete(licenseLockLabel)
        licenseLockLabel := na
    // TF gate diagnostics — do not alter strategy math; never silently suppress without a label.
    tfMsg = not strategyCfgOk ? "{{DIAG_UNSUPPORTED}}" : not htfConfigured ? "{{DIAG_MISSING_HTF}}" : not entryChartOk ? "{{DIAG_WRONG_ENTRY}}" : not htfTfOk ? "{{DIAG_WRONG_HTF}}" : chartIsHtf ? "{{DIAG_CHART_IS_HTF}}" : ""
    if str.length(tfMsg) > 0 and licenseOk
        if na(tfLockLabel)
            tfLockLabel := label.new(bar_index, low, tfMsg, style=label.style_label_up, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
        else
            label.set_xy(tfLockLabel, bar_index, low)
            label.set_text(tfLockLabel, tfMsg)
    else if not na(tfLockLabel)
        label.delete(tfLockLabel)
        tfLockLabel := na

// ===== COLORS (BUY vs SELL schemes) =====
colBuy = #2563eb
colSell = #dc2626
colTpNear = #16a34a
colTpFar = #d97706
colSlBuy = #dc2626
colSlSell = #2563eb
colLongZoneBg = color.new(#16a34a, 85)
colLongZoneBorder = color.new(#16a34a, 30)
colShortZoneBg = color.new(#dc2626, 85)
colShortZoneBorder = color.new(#dc2626, 30)

atr14 = ta.atr(14)

// Instrument tick magnitude for ATR/stop fallbacks only — never used to invent display decimals.
pointSize() =>
    math.max(nz(syminfo.mintick, 1e-8), 1e-8)

// ONE universal price→text formatter for every instrument (labels, alerts, webhooks).
// Uses TradingView syminfo.mintick — format ONLY for display; never round before calculations.
formatPrice(float px) =>
    str.tostring(px, format.mintick)

fmtPx(float px) =>
    formatPrice(px)

kachingAlertLabel(string alertType) =>
    alertType == "entry" ? "Kaching Entry" :
     alertType == "stop_loss" ? "Kaching SL" :
     alertType == "take_profit_1" ? "Kaching TP1" :
     alertType == "take_profit_2" ? "Kaching TP2" :
     alertType == "take_profit_3" ? "Kaching TP3" :
     alertType == "expired" ? "Kaching Expired" :
     alertType == "cancelled" ? "Kaching Cancelled" :
     "Kaching Signal"

// Human-readable alert body (stored in JSON message; webhook still receives full JSON)
buildHumanMessage(string direction, float entry, float sl, float tp1, float tp2, float tp3) =>
    header = direction == "long" ? "🟦 Kaching BUY" : "🟥 Kaching SELL"
    header + "\\nEntry: " + formatPrice(entry) + "\\nSL: " + formatPrice(sl) + "\\nTP1: " + formatPrice(tp1) + "\\nTP2: " + formatPrice(tp2) + "\\nTP3: " + formatPrice(tp3)

buildPayload(string alertType, string direction, float entry, float sl, float tp1, float tp2, float tp3, float gapTop, float gapBot, float conf, string signalId, string closedReason) =>
    msgText = alertType == "entry" ? buildHumanMessage(direction, entry, sl, tp1, tp2, tp3) : kachingAlertLabel(alertType)
    reasonJson = str.length(closedReason) > 0 ? ',"closedReason":"' + closedReason + '"' : ""
    '{"symbol":"' + syminfo.ticker + '","strategyName":"Liquidity Sweep + Fair Value Gap (Scalping)","timeframe":"' + timeframe.period + '","pattern":"liquidity_sweep_fvg_scalp","alertType":"' + alertType + '","direction":"' + direction + '","entry":' + fmtPx(entry) + ',"stop_loss":' + fmtPx(sl) + ',"stop_loss_1":' + fmtPx(sl) + ',"take_profit_1":' + fmtPx(tp1) + ',"take_profit_2":' + fmtPx(tp2) + ',"take_profit_3":' + fmtPx(tp3) + ',"gapTop":' + fmtPx(gapTop) + ',"gapBottom":' + fmtPx(gapBot) + ',"confidence":' + str.tostring(conf, "#.##") + ',"signalId":"' + signalId + '","signalUuid":"' + signalId + '","expiryBars":' + str.tostring(expiryBars) + ',"enableTradeExpiry":' + (enableTradeExpiry ? "true" : "false") + ',"active":true,"message":"' + msgText + '","userId":"{{SUBSCRIBER_ID}}","licenseToken":"' + LICENSE_TOKEN + '","tradingviewUsername":"' + LICENSED_TV_USERNAME + '","broadcast":true' + reasonJson + '}'

// ===== HTF LIQUIDITY / STRUCTURE ({{ARCH_HTF_LABEL}} via request.security — never entry price) =====
// lookahead_off + barstate.isconfirmed keep historical/realtime parity (no future HTF peek).
htfHigh = request.security(syminfo.tickerid, htfTf, high, barmerge.gaps_off, barmerge.lookahead_off)
htfLow = request.security(syminfo.tickerid, htfTf, low, barmerge.gaps_off, barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTf, close, barmerge.gaps_off, barmerge.lookahead_off)
htfAtr = request.security(syminfo.tickerid, htfTf, ta.atr(14), barmerge.gaps_off, barmerge.lookahead_off)

htfSwingHigh = request.security(syminfo.tickerid, htfTf, ta.pivothigh(high, swingLen, swingLen), barmerge.gaps_off, barmerge.lookahead_off)
htfSwingLow = request.security(syminfo.tickerid, htfTf, ta.pivotlow(low, swingLen, swingLen), barmerge.gaps_off, barmerge.lookahead_off)

var float lastSwingHigh = na
var float lastSwingLow = na
if not na(htfSwingHigh)
    lastSwingHigh := htfSwingHigh
if not na(htfSwingLow)
    lastSwingLow := htfSwingLow

// Sweep = trade beyond + close back (reject) on HTF series mapped to chart bars
bullSweep = not na(lastSwingLow) and htfLow < lastSwingLow and htfClose > lastSwingLow
bearSweep = not na(lastSwingHigh) and htfHigh > lastSwingHigh and htfClose < lastSwingHigh

var int sweepDir = 0
var float sweepExtreme = na
var float sweepLevel = na
var int sweepBar = na
if bullSweep and barstate.isconfirmed
    sweepDir := 1
    sweepExtreme := htfLow
    sweepLevel := lastSwingLow
    sweepBar := bar_index
if bearSweep and barstate.isconfirmed
    sweepDir := -1
    sweepExtreme := htfHigh
    sweepLevel := lastSwingHigh
    sweepBar := bar_index

// Ignore setups before HTF sweep / stale sweeps
sweepFresh = not na(sweepBar) and (bar_index - sweepBar) <= 40 and sweepDir != 0

// ===== LTF MSS =====
pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow = ta.pivotlow(low, swingLen, swingLen)
var float lastLH = na
var float lastHL = na
if not na(pivotHigh)
    lastLH := pivotHigh
if not na(pivotLow)
    lastHL := pivotLow

bullMss = sweepFresh and sweepDir == 1 and not na(lastLH) and close > lastLH and barstate.isconfirmed
bearMss = sweepFresh and sweepDir == -1 and not na(lastHL) and close < lastHL and barstate.isconfirmed

var int mssDir = 0
var int mssBar = na
if bullMss
    mssDir := 1
    mssBar := bar_index
if bearMss
    mssDir := -1
    mssBar := bar_index

mssActive = not na(mssBar) and mssDir == sweepDir and (bar_index - mssBar) <= 24

// ===== DISPLACEMENT =====
bodyRatio(cOpen, cClose, cHigh, cLow) =>
    math.abs(cClose - cOpen) / math.max(cHigh - cLow, syminfo.mintick)

wickRatio(cOpen, cClose, cHigh, cLow) =>
    (cHigh - math.max(cOpen, cClose) + math.min(cOpen, cClose) - cLow) / math.max(cHigh - cLow, syminfo.mintick)

avgBody = ta.sma(math.abs(close - open), 14)
cRange = high - low
bullDisp = mssActive and mssDir == 1 and close > open and bodyRatio(open, close, high, low) >= minBodyRatio and wickRatio(open, close, high, low) <= maxWickRatio and math.abs(close - open) > avgBody * 1.15 and cRange > atr14 * minDispAtr and (high - close) / math.max(cRange, syminfo.mintick) <= 0.25 and barstate.isconfirmed
bearDisp = mssActive and mssDir == -1 and close < open and bodyRatio(open, close, high, low) >= minBodyRatio and wickRatio(open, close, high, low) <= maxWickRatio and math.abs(close - open) > avgBody * 1.15 and cRange > atr14 * minDispAtr and (close - low) / math.max(cRange, syminfo.mintick) <= 0.25 and barstate.isconfirmed

var int dispBar = na
var int dispDir = 0
if bullDisp
    dispBar := bar_index
    dispDir := 1
if bearDisp
    dispBar := bar_index
    dispDir := -1

dispActive = not na(dispBar) and dispDir == sweepDir and (bar_index - dispBar) <= 18

// ===== ENGULFING (preferred) =====
bullEngulf = close > open and close[1] < open[1] and close >= math.max(open[1], close[1]) and open <= math.min(open[1], close[1])
bearEngulf = close < open and close[1] > open[1] and open >= math.max(open[1], close[1]) and close <= math.min(open[1], close[1])
engulfOk = not requireEngulf or (dispDir == 1 and bullEngulf) or (dispDir == -1 and bearEngulf)

// ===== ICT FVG =====
bullFvg = dispActive and high[2] < low[0] and (low[0] - high[2]) >= atr14 * minGapAtr and barstate.isconfirmed and bar_index > dispBar
bearFvg = dispActive and low[2] > high[0] and (low[2] - high[0]) >= atr14 * minGapAtr and barstate.isconfirmed and bar_index > dispBar

var float fvgTop = na
var float fvgBot = na
var float fvgCe = na
var int fvgBar = na
var int fvgDir = 0
if bullFvg and engulfOk
    fvgTop := low[0]
    fvgBot := high[2]
    fvgCe := (fvgTop + fvgBot) / 2
    fvgBar := bar_index
    fvgDir := 1
if bearFvg and engulfOk
    fvgTop := low[2]
    fvgBot := high[0]
    fvgCe := (fvgTop + fvgBot) / 2
    fvgBar := bar_index
    fvgDir := -1

fvgActive = not na(fvgBar) and fvgDir == sweepDir and (bar_index - fvgBar) <= 10 and bar_index > fvgBar

// Doji on C3 (confidence only)
c3Doji = math.abs(close - open) / math.max(high - low, syminfo.mintick) <= 0.12

// ===== RETRACE INTO FVG (never enter on displacement bar) =====
zoneTop = entryModel == "ce" ? fvgCe + (fvgTop - fvgBot) * 0.08 : entryModel == "upper_half" ? fvgTop : entryModel == "lower_half" ? fvgCe : fvgTop
zoneBot = entryModel == "ce" ? fvgCe - (fvgTop - fvgBot) * 0.08 : entryModel == "upper_half" ? fvgCe : entryModel == "lower_half" ? fvgBot : fvgBot

retraceLong = fvgActive and fvgDir == 1 and bar_index > dispBar and low <= zoneTop and high >= zoneBot and close >= fvgBot
retraceShort = fvgActive and fvgDir == -1 and bar_index > dispBar and low <= zoneTop and high >= zoneBot and close <= fvgTop

// ===== CONFIDENCE (weights match backend) =====
confScore() =>
    float s = 0.0
    if sweepFresh
        s += 30
    if mssActive
        s += 20
    if dispActive
        s += 15
    if fvgActive
        s += 15
    if retraceLong or retraceShort
        s += 10
    if (fvgDir == 1 and bullEngulf) or (fvgDir == -1 and bearEngulf)
        s += 5
    if c3Doji
        s += 5
    s

// ===== LEVELS =====
calcLevels(string direction, float entryPx, float slPx) =>
    risk = math.abs(entryPx - slPx)
    float tp1 = direction == "long" ? entryPx + risk * tp1R : entryPx - risk * tp1R
    float tp2 = direction == "long" ? entryPx + risk * tp2R : entryPx - risk * tp2R
    float tp3 = direction == "long" ? entryPx + risk * tp3R : entryPx - risk * tp3R
    // ATR distance caps (Pine approximates backend dynamic TP caps; full SMC ranking is backend)
    if enableDynamicTp
        atrNow = nz(atr14, pointSize())
        cap1 = atrNow * tp1AtrCap
        cap2 = atrNow * tp2AtrCap
        cap3 = atrNow * tp3AtrCap
        tp1 := direction == "long" ? math.min(tp1, entryPx + cap1) : math.max(tp1, entryPx - cap1)
        tp2 := direction == "long" ? math.min(tp2, entryPx + cap2) : math.max(tp2, entryPx - cap2)
        tp3 := direction == "long" ? math.min(tp3, entryPx + cap3) : math.max(tp3, entryPx - cap3)
    [entryPx, slPx, tp1, tp2, tp3, risk]

resolveStop(string direction, float entryPx) =>
    buf = nz(atr14, pointSize()) * 0.05
    sweepSl = direction == "long" ? sweepExtreme - buf : sweepExtreme + buf
    fvgSl = direction == "long" ? fvgBot - buf : fvgTop + buf
    stopModel == "fvg" ? fvgSl : stopModel == "sweep_or_fvg" ? (direction == "long" ? math.min(sweepSl, fvgSl) : math.max(sweepSl, fvgSl)) : sweepSl

resolveEntry(string direction) =>
    entryModel == "ce" ? fvgCe : close

// DEBUG_MODE helper (must be declared before DRAWING_ENGINE executable blocks).
// Does not change strategy math — only labels/log why alert() is skipped.
pineAlertBlockReason(bool tradeActiveNow) =>
    not licenseOk ? "license" :
     not strategyCfgOk ? "unsupported_strategy_cfg" :
     not htfConfigured ? "htf_missing" :
     not entryChartOk ? "wrong_entry_tf" :
     not htfTfOk ? "wrong_htf" :
     chartIsHtf ? "chart_is_htf" :
     tradeActiveNow ? "trade_active" :
     not barstate.isrealtime ? "not_realtime" :
     not barstate.isconfirmed ? "bar_unconfirmed" :
     confScore() < confThreshold ? "confidence" :
     not fvgActive ? "fvg_invalid" :
     not (retraceLong or retraceShort) ? "retrace" :
     "no_setup"

// entryTfOk computed in TIMEFRAME VALIDATION (Scalping) — {{ARCH_ENTRY_LABEL}} entry + {{ARCH_HTF_LABEL}} HTF.

{{DRAWING_ENGINE}}

// One active trade per chart: never fire/replace while a trade is still open.
// Alerts fire only on valid entry TF bars (entryTfOk); HTF is confirmation-only.
// barstate.isrealtime: TradingView ignores alert() on historical bars — without this gate,
// Entry/SL/TP drawings armed on history with no webhook (orphan visuals vs ALERT NOT FIRED).
fireLong = licenseOk and entryTfOk and not tradeIsActive() and retraceLong and barstate.isconfirmed and barstate.isrealtime and confScore() >= confThreshold
fireShort = licenseOk and entryTfOk and not tradeIsActive() and retraceShort and barstate.isconfirmed and barstate.isrealtime and confScore() >= confThreshold
// Single confirmation event: drawings, UUID, alert(), and lifecycle arm ONLY when this is true.
confirmedSignal = fireLong or fireShort

// DEBUG_MODE diagnostics only — never changes fireLong / fireShort / alert() gates.
if DEBUG_MODE and barstate.islast
    dbgTradeActive = tradeIsActive()
    dbgReason = pineAlertBlockReason(dbgTradeActive)
    dbgState = "chartTF=" + timeframe.period + " entryTF={{ARCH_ENTRY_LABEL}} htf=" + htfTf + " conf=" + str.tostring(confScore(), "#.#") + "/" + str.tostring(confThreshold, "#.#") + " licenseOk=" + str.tostring(licenseOk) + " entryTfOk=" + str.tostring(entryTfOk) + " htfTfOk=" + str.tostring(htfTfOk) + " tradeActive=" + str.tostring(dbgTradeActive) + " realtime=" + str.tostring(barstate.isrealtime) + " confirmed=" + str.tostring(barstate.isconfirmed) + " fireLong=" + str.tostring(fireLong) + " fireShort=" + str.tostring(fireShort) + " confirmedSignal=" + str.tostring(confirmedSignal)
    log.info("[PIPELINE] DEBUG STATE | " + syminfo.ticker + " | " + dbgState)
    if not confirmedSignal
        dbgText = "DEBUG: " + dbgReason + " | " + dbgState
        if na(debugBlockLabel)
            debugBlockLabel := label.new(bar_index, high, dbgText, style=label.style_label_down, color=color.new(color.purple, 0), textcolor=color.white, size=size.small)
        else
            label.set_xy(debugBlockLabel, bar_index, high)
            label.set_text(debugBlockLabel, dbgText)
        log.info("[PIPELINE] ALERT NOT FIRED | " + syminfo.ticker + " | " + timeframe.period + " | reason=" + dbgReason + " | " + dbgState)
    else if not na(debugBlockLabel)
        label.delete(debugBlockLabel)
        debugBlockLabel := na
else if not na(debugBlockLabel) and not DEBUG_MODE
    label.delete(debugBlockLabel)
    debugBlockLabel := na

// Arm trade ONLY on confirmedSignal (fireLong). Same event: drawings → DRAWING CREATED → ALERT FIRING → alert().
if fireLong
    e = resolveEntry("long")
    sl = resolveStop("long", e)
    [ee, ssl, t1, t2, t3, _] = calcLevels("long", e, sl)
    conf = confScore() / 100.0
    sigId = makeSignalId()
    msg = buildPayload("entry", "long", ee, ssl, t1, t2, t3, fvgTop, fvgBot, conf, sigId, "")
    // clearPreviousTrade (inlined) — wipe any stale drawings before arming.
    if array.size(tradeLevelLines) > 0
        for i = 0 to array.size(tradeLevelLines) - 1
            line.delete(array.get(tradeLevelLines, i))
    if array.size(tradeLeaderLines) > 0
        for i = 0 to array.size(tradeLeaderLines) - 1
            line.delete(array.get(tradeLeaderLines, i))
    if array.size(tradeLevelLabels) > 0
        for i = 0 to array.size(tradeLevelLabels) - 1
            label.delete(array.get(tradeLevelLabels, i))
    array.clear(tradeLevelLines)
    array.clear(tradeLeaderLines)
    array.clear(tradeLevelLabels)
    if array.size(tradeBadgeHold) > 0
        label.delete(array.get(tradeBadgeHold, 0))
        array.clear(tradeBadgeHold)
    if array.size(tradeFvgHold) > 0
        box.delete(array.get(tradeFvgHold, 0))
        array.clear(tradeFvgHold)
    buyBadge = label.new(bar_index, ee, "Kaching Buy", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=colBuy, textcolor=color.white, size=size.small)
    array.push(tradeBadgeHold, buyBadge)
    if SHOW_FVG_ZONE
        buyZone = box.new(bar_index - 2, math.max(fvgTop, fvgBot), bar_index + 5, math.min(fvgTop, fvgBot), border_color=colLongZoneBorder, border_width=1, bgcolor=colLongZoneBg)
        array.push(tradeFvgHold, buyZone)
