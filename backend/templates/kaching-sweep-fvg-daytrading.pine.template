//@version=5
// COMPILE REQUIREMENT (Option A event_bridge_v1): dynamic_requests=true
// Required because request.security_lower_tf / request.security run inside local scopes
// (chart vs canonical bridge) and canonSignalTuple() nests HTF request.security().
indicator("{{INDICATOR_TITLE}}", shorttitle="{{INDICATOR_SHORTTITLE}}", overlay=true, dynamic_requests=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// Generated for: {{SUBSCRIBER_LABEL}}
// Tier: {{SUBSCRIPTION_TIER}} | Script ID: {{SCRIPT_ID}}
// pineClientVersion: {{PINE_CLIENT_VERSION}} | scriptGenerationId: {{SCRIPT_GENERATION_ID}} | generatedAt: {{PINE_GENERATED_AT}}
// Strategy: Liquidity Sweep + Fair Value Gap (Day Trading)
// TF architecture (Option A + event_bridge_v1): allowed display = {{ARCH_ENTRY_LABEL}}; canonical signal TF = {{ARCH_CANONICAL_SIGNAL_TF}}; HTF = {{ARCH_HTF_LABEL}} via nested request.security.
// One canonical engine → event-safe bridge (security_lower_tf when chart > canonical) → same UUID/Entry/SL/TP on every allowed display TF.
// Lifecycle/expiry use canonical OHLC bars. Wrong-TF lock only when chart is outside the allowed display list.
// TradingView overlays show ONLY: Kaching Buy/Sell, Entry, SL, TP1–3 (with prices).

// ===== CONFIGURATION =====
// License is HMAC-bound to this TradingView username (server-side). Pine cannot read the
// current TV account at runtime, so CONFIRM is prefilled to the licensed username (override allowed).
WEBHOOK_URL = "{{WEBHOOK_URL}}"
LICENSE_TOKEN = "{{LICENSE_TOKEN}}"
LICENSED_TV_USERNAME = "{{TV_USERNAME}}"
CONFIRM_TV_USERNAME = input.string("{{TV_USERNAME}}", "Confirm your TradingView username", group="KachingFx License", tooltip="Prefilled with the username this script was licensed for. Leave as-is to unlock, or override if needed. Signals and alerts stay locked until it matches.")
SHOW_TRADE_LINES = true
SHOW_FVG_ZONE = input.bool(false, "Shade the fair value gap zone", group="KachingFx")
DEBUG_MODE = input.bool(false, "DEBUG_MODE — show block reasons", group="KachingFx", tooltip="When ON: on-chart labels + Pine Logs show skip reasons and full gate state (chart/canonical/HTF TF, confidence, licenseOk, isAllowedDisplayTf, tradeActive, confirmed, fireLong/Short). Does NOT change strategy math. Turn OFF for live trading.")
levelExtendBars = input.int(22, "Initial trade level length (bars)", minval=8, maxval=60, group="KachingFx Display", tooltip="Starting length of Entry/SL/TP lines. While a trade is active, lines keep extending with each new candle until TP3/SL/expiry/cancel.")
enableTradeExpiry = input.bool(true, "Enable trade candle expiry", group="KachingFx Display", tooltip="When ON, active trades auto-close after expiryBars canonical candles if TP3/SL not hit. When OFF, trades stay until TP3/SL/cancel only. Never clears because a later scan finds no setup.")
expiryBars = input.int(80, "Active trade expiry (canonical candles)", minval=5, maxval=500, group="KachingFx Display", tooltip="Close after this many CANONICAL signal-TF candles (5m for Day Trading), not chart candles. Default 80 × 5m. Independent of whether you view 5m or 15m.")
smartLabelMinVerticalTicks = input.int(12, "Smart label min vertical gap (ticks)", minval=2, maxval=250, group="KachingFx Display", tooltip="Minimum price-space gap between trade labels before lower-priority labels are shifted.")
minHorizontalGapBars = input.int(2, "Smart label min horizontal gap (bars)", minval=1, maxval=8, group="KachingFx Display", tooltip="Horizontal spacing used for staggered smart labels and left/right spillover.")

htfTf = input.timeframe("{{HTF_TF}}", "{{HTF_INPUT_LABEL}}", group="Day — Structure", tooltip="{{HTF_INPUT_TOOLTIP}}")
swingLen = input.int({{SWING_SENSITIVITY}}, "Swing sensitivity", minval=1, maxval=5, group="Day — Structure")
eqTolAtr = input.float({{EQH_EQL_TOLERANCE}}, "EQH/EQL ATR tolerance", minval=0.01, maxval=0.5, group="Day — Structure")

minBodyRatio = input.float({{MIN_BODY_RATIO}}, "Displacement min body/range", minval=0.4, maxval=0.95, group="Day — Displacement")
maxWickRatio = input.float({{MAX_WICK_RATIO}}, "Displacement max wick/range", minval=0.05, maxval=0.5, group="Day — Displacement")
minDispAtr = input.float({{DISP_ATR_MULT}}, "Displacement min range/ATR", minval=0.5, maxval=3.0, group="Day — Displacement")

minGapAtr = input.float({{MIN_FVG_ATR}}, "Min FVG / ATR", minval=0.05, maxval=1.0, group="Day — FVG")
entryModel = input.string("{{ENTRY_MODEL}}", "Entry model", options=["ce", "entire", "upper_half", "lower_half"], group="Day — Entry")
stopModel = input.string("{{STOP_MODEL}}", "Stop model", options=["sweep", "fvg", "sweep_or_fvg"], group="Day — Risk")
slBufferAtr = input.float({{SL_BUFFER_ATR}}, "SL buffer (ATR ratio)", minval=0.0, maxval=1.0, group="Day — Risk", tooltip="Tiny buffer beyond structural stop. Does NOT cap SL distance.")
maxStopAtrMult = input.float({{MAX_STOP_ATR_MULT}}, "Max stop (ATR mult)", minval=0.1, maxval=20.0, group="Day — Risk", tooltip="Maximum permitted SL distance = canonical-TF ATR × this multiplier. Structural stops beyond this are rejected or fall back to a valid FVG stop.")
minRr = input.float({{MIN_RR}}, "Minimum RR (TP1)", minval=0.1, maxval=10.0, group="Day — Risk", tooltip="Reject trade if TP1 reward/risk using FINAL SL is below this floor.")
tp1R = input.float({{TP1_R}}, "Kaching TP1 (R)", group="Day — Risk")
tp2R = input.float({{TP2_R}}, "Kaching TP2 (R)", group="Day — Risk")
tp3R = input.float({{TP3_R}}, "Kaching TP3 (R)", group="Day — Risk")
enableDynamicTp = input.bool({{ENABLE_DYNAMIC_TP}}, "Enable dynamic TP (ATR caps)", group="Day — Risk")
tp1AtrCap = input.float({{TP1_ATR_CAP}}, "TP1 max ATR", minval=0.1, group="Day — Risk")
tp2AtrCap = input.float({{TP2_ATR_CAP}}, "TP2 max ATR", minval=0.1, group="Day — Risk")
tp3AtrCap = input.float({{TP3_ATR_CAP}}, "TP3 max ATR", minval=0.1, group="Day — Risk")
confThreshold = input.float({{CONFIDENCE_THRESHOLD}}, "Min confidence (0-100)", minval=50, maxval=100, group="Day — Filters")
requireEngulf = input.bool({{REQUIRE_ENGULFING}}, "Require engulfing", group="Day — Filters")

normalizeTvUser(string s) =>
    str.lower(str.replace_all(str.trim(s), "@", ""))

licenseOk = str.length(LICENSED_TV_USERNAME) > 0 and normalizeTvUser(CONFIRM_TV_USERNAME) == normalizeTvUser(LICENSED_TV_USERNAME)

// ===== TIMEFRAME GATE (Option A — Day Trading) =====
// Allowed display charts from Strategy Configuration. Canonical engine is independent of chart TF.
STRATEGY_KEY = "{{STRATEGY_KEY}}"
strategyCfgOk = STRATEGY_KEY == "daytrading"
CANONICAL_SIGNAL_TF = "{{CANONICAL_SIGNAL_TF}}"
isCanonicalChart = timeframe.period == CANONICAL_SIGNAL_TF
// Allowed entry/display charts (hard gate for arm/alert — not for chart==canonical).
entryChartOk = {{ENTRY_CHART_OK}}
isAllowedDisplayTf = entryChartOk
// HTF input diagnostics (non-blocking; nested security still runs with the selected HTF).
htfSec = timeframe.in_seconds(htfTf)
htfConfigured = htfSec > 0
htfTfOk = {{HTF_TF_OK}}
chartSec = timeframe.in_seconds()
chartIsHtf = htfConfigured and chartSec == htfSec
entryTfPreferred = strategyCfgOk and isAllowedDisplayTf and htfConfigured and htfTfOk and not chartIsHtf
entryTfOk = entryTfPreferred
// Trading style from chart TF — metadata/UI only; never used in fire conditions.
tradingStyle = {{TRADING_STYLE_EXPR}}

// Any TradingView instrument is valid — chart OHLC is the source of truth (no symbol allowlist).
var label licenseLockLabel = na
var label tfLockLabel = na
var label debugBlockLabel = na
if barstate.islast
    if not licenseOk
        if na(licenseLockLabel)
            licenseLockLabel := label.new(bar_index, high, "KachingFx: enter licensed TradingView username to unlock", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.normal)
        else
            label.set_xy(licenseLockLabel, bar_index, high)
    else if not na(licenseLockLabel)
        label.delete(licenseLockLabel)
        licenseLockLabel := na
    // Wrong-TF lock ONLY when chart is outside allowed display list (canonical!=chart is OK).
    tfMsg = not strategyCfgOk ? "{{DIAG_UNSUPPORTED}}" : not entryChartOk ? "{{DIAG_WRONG_ENTRY}}" : ""
    if str.length(tfMsg) > 0 and licenseOk
        if na(tfLockLabel)
            tfLockLabel := label.new(bar_index, low, tfMsg + " · style=" + tradingStyle, style=label.style_label_up, color=color.new(color.orange, 0), textcolor=color.white, size=size.small)
        else
            label.set_xy(tfLockLabel, bar_index, low)
            label.set_text(tfLockLabel, tfMsg + " · style=" + tradingStyle)
    else if not na(tfLockLabel)
        label.delete(tfLockLabel)
        tfLockLabel := na

// ===== COLORS (BUY vs SELL schemes) =====
colBuy = #2563eb
colSell = #dc2626
colTpNear = #16a34a
colTpFar = #d97706
colSlBuy = #dc2626
colSlSell = #2563eb
colLongZoneBg = color.new(#16a34a, 85)
colLongZoneBorder = color.new(#16a34a, 30)
colShortZoneBg = color.new(#dc2626, 85)
colShortZoneBorder = color.new(#dc2626, 30)

// Instrument tick magnitude for ATR/stop fallbacks only — never used to invent display decimals.
pointSize() =>
    math.max(nz(syminfo.mintick, 1e-8), 1e-8)

// ONE universal price→text formatter for every instrument (labels, alerts, webhooks).
// Uses TradingView syminfo.mintick — format ONLY for display; never round before calculations.
formatPrice(float px) =>
    str.tostring(px, format.mintick)

fmtPx(float px) =>
    formatPrice(px)

kachingAlertLabel(string alertType) =>
    alertType == "entry" ? "Kaching Entry" :
     alertType == "stop_loss" ? "Kaching SL" :
     alertType == "take_profit_1" ? "Kaching TP1" :
     alertType == "take_profit_2" ? "Kaching TP2" :
     alertType == "take_profit_3" ? "Kaching TP3" :
     alertType == "expired" ? "Kaching Expired" :
     alertType == "cancelled" ? "Kaching Cancelled" :
     "Kaching Signal"

// Escape string values for deterministic JSON (prevents WebhookParseError).
jsonEsc(string s) =>
    str.replace_all(str.replace_all(str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\r", "\\r")

// Human-readable alert body (stored in JSON message; webhook still receives full JSON)
buildHumanMessage(string direction, float entry, float sl, float tp1, float tp2, float tp3) =>
    header = direction == "long" ? "🟦 Kaching BUY" : "🟥 Kaching SELL"
    header + "\\nEntry: " + formatPrice(entry) + "\\nSL: " + formatPrice(sl) + "\\nTP1: " + formatPrice(tp1) + "\\nTP2: " + formatPrice(tp2) + "\\nTP3: " + formatPrice(tp3)

// timeframe = CANONICAL_SIGNAL_TF (not chart period). chartTf / canonicalSignalTf / canonicalSignalKey are additive.
buildPayload(string alertType, string direction, float entry, float sl, float tp1, float tp2, float tp3, float gapTop, float gapBot, float conf, string signalId, string closedReason) =>
    msgText = jsonEsc(alertType == "entry" ? buildHumanMessage(direction, entry, sl, tp1, tp2, tp3) : kachingAlertLabel(alertType))
    reasonJson = str.length(closedReason) > 0 ? ',"closedReason":"' + jsonEsc(closedReason) + '"' : ""
    '{"symbol":"' + jsonEsc(syminfo.ticker) + '","strategyName":"Liquidity Sweep + Fair Value Gap (Day Trading)","timeframe":"' + jsonEsc(CANONICAL_SIGNAL_TF) + '","chartTf":"' + jsonEsc(timeframe.period) + '","canonicalSignalTf":"' + jsonEsc(CANONICAL_SIGNAL_TF) + '","canonicalSignalKey":"' + jsonEsc(signalId) + '","pattern":"liquidity_sweep_fvg_daytrading","alertType":"' + jsonEsc(alertType) + '","direction":"' + jsonEsc(direction) + '","entry":' + fmtPx(entry) + ',"stop_loss":' + fmtPx(sl) + ',"stop_loss_1":' + fmtPx(sl) + ',"take_profit_1":' + fmtPx(tp1) + ',"take_profit_2":' + fmtPx(tp2) + ',"take_profit_3":' + fmtPx(tp3) + ',"gapTop":' + fmtPx(gapTop) + ',"gapBottom":' + fmtPx(gapBot) + ',"confidence":' + str.tostring(conf, "#.##") + ',"signalId":"' + jsonEsc(signalId) + '","signalUuid":"' + jsonEsc(signalId) + '","expiryBars":' + str.tostring(expiryBars) + ',"enableTradeExpiry":' + (enableTradeExpiry ? "true" : "false") + ',"active":true,"message":"' + msgText + '","userId":"{{SUBSCRIBER_ID}}","licenseToken":"' + jsonEsc(LICENSE_TOKEN) + '","tradingviewUsername":"' + jsonEsc(LICENSED_TV_USERNAME) + '","broadcast":true,"pineClientVersion":"{{PINE_CLIENT_VERSION}}","generatedAt":"{{PINE_GENERATED_AT}}","scriptGenerationId":"{{SCRIPT_GENERATION_ID}}","capabilities":{{PINE_CAPABILITIES_JSON}}' + reasonJson + '}'

// Stable UUID across all allowed display TFs (uses canonical bar time, not chart bar_index).
makeCanonicalSignalId(int signalTime, string direction) =>
    syminfo.ticker + "-" + STRATEGY_KEY + "-c" + CANONICAL_SIGNAL_TF + "-" + str.tostring(signalTime) + "-" + direction

// ===== PURE HELPERS (SL/RR math unchanged; ATR from calling series context) =====
bodyRatio(cOpen, cClose, cHigh, cLow) =>
    math.abs(cClose - cOpen) / math.max(cHigh - cLow, syminfo.mintick)

wickRatio(cOpen, cClose, cHigh, cLow) =>
    (cHigh - math.max(cOpen, cClose) + math.min(cOpen, cClose) - cLow) / math.max(cHigh - cLow, syminfo.mintick)

isSyntheticTicker() =>
    t = str.upper(syminfo.ticker)
    str.contains(t, "JUMP") or str.contains(t, "BOOM") or str.contains(t, "CRASH") or str.contains(t, "VOLATILITY") or str.contains(t, "STEP") or str.contains(t, "RANGE") or str.contains(t, "DEX")

stopSideOk(string direction, float entryPx, float slPx) =>
    direction == "long" ? slPx < entryPx : slPx > entryPx

// Returns [ok, finalSl, kindCode, distance]
// kindCode: 1=sweep, 2=fvg, 0=none
// Never clamps structural SL arbitrarily closer to entry.
resolveValidStop(string direction, float entryPx, float sweepExtreme, float fvgTop, float fvgBot) =>
    atrNow = nz(ta.atr(14), pointSize())
    buf = atrNow * slBufferAtr
    maxDist = atrNow * maxStopAtrMult
    sweepSl = direction == "long" ? sweepExtreme - buf : sweepExtreme + buf
    fvgSl = direction == "long" ? fvgBot - buf : fvgTop + buf
    sweepOk = not na(sweepSl) and stopSideOk(direction, entryPx, sweepSl) and math.abs(entryPx - sweepSl) > 0 and math.abs(entryPx - sweepSl) <= maxDist
    fvgOk = not na(fvgSl) and stopSideOk(direction, entryPx, fvgSl) and math.abs(entryPx - fvgSl) > 0 and math.abs(entryPx - fvgSl) <= maxDist
    bool ok = false
    float finalSl = na
    int kindCode = 0
    // JUMP/synthetics: FVG first. Else configured model, then fallback. Prefer closer valid stop for sweep_or_fvg.
    if isSyntheticTicker()
        if fvgOk
            ok := true
            finalSl := fvgSl
            kindCode := 2
        else if sweepOk
            ok := true
            finalSl := sweepSl
            kindCode := 1
    else if stopModel == "fvg"
        if fvgOk
            ok := true
            finalSl := fvgSl
            kindCode := 2
        else if sweepOk
            ok := true
            finalSl := sweepSl
            kindCode := 1
    else if stopModel == "sweep_or_fvg"
        if sweepOk and fvgOk
            if math.abs(entryPx - fvgSl) <= math.abs(entryPx - sweepSl)
                ok := true
                finalSl := fvgSl
                kindCode := 2
            else
                ok := true
                finalSl := sweepSl
                kindCode := 1
        else if fvgOk
            ok := true
            finalSl := fvgSl
            kindCode := 2
        else if sweepOk
            ok := true
            finalSl := sweepSl
            kindCode := 1
    else
        if sweepOk
            ok := true
            finalSl := sweepSl
            kindCode := 1
        else if fvgOk
            ok := true
            finalSl := fvgSl
            kindCode := 2
    dist = ok ? math.abs(entryPx - finalSl) : na
    [ok, finalSl, kindCode, dist]

calcLevels(string direction, float entryPx, float slPx) =>
    risk = math.abs(entryPx - slPx)
    float tp1 = direction == "long" ? entryPx + risk * tp1R : entryPx - risk * tp1R
    float tp2 = direction == "long" ? entryPx + risk * tp2R : entryPx - risk * tp2R
    float tp3 = direction == "long" ? entryPx + risk * tp3R : entryPx - risk * tp3R
    // ATR distance caps apply to TP only — never rewrite FINAL SL.
    if enableDynamicTp
        atrNow = nz(ta.atr(14), pointSize())
        cap1 = atrNow * tp1AtrCap
        cap2 = atrNow * tp2AtrCap
        cap3 = atrNow * tp3AtrCap
        tp1 := direction == "long" ? math.min(tp1, entryPx + cap1) : math.max(tp1, entryPx - cap1)
        tp2 := direction == "long" ? math.min(tp2, entryPx + cap2) : math.max(tp2, entryPx - cap2)
        tp3 := direction == "long" ? math.min(tp3, entryPx + cap3) : math.max(tp3, entryPx - cap3)
    [entryPx, slPx, tp1, tp2, tp3, risk]

rrOk(string direction, float entryPx, float slPx, float tp1) =>
    risk = math.abs(entryPx - slPx)
    reward = math.abs(tp1 - entryPx)
    sideOk = direction == "long" ? tp1 > entryPx : tp1 < entryPx
    risk > 0 and reward > 0 and sideOk and (reward / risk) >= minRr

// ===== CANONICAL SIGNAL ENGINE (Option A) =====
// Evaluated via request.security on CANONICAL_SIGNAL_TF so every allowed display chart
// sees the same ready flags + levels. Nested HTF security stays inside. lookahead_off only.
// Returns: [readyLong, readyShort, entry, sl, tp1, tp2, tp3, gapTop, gapBot, conf, signalTime, slKind]
canonSignalTuple() =>
    atr14 = ta.atr(14)
    // HTF liquidity / structure (nested; never entry price)
    htfHigh = request.security(syminfo.tickerid, htfTf, high, barmerge.gaps_off, barmerge.lookahead_off)
    htfLow = request.security(syminfo.tickerid, htfTf, low, barmerge.gaps_off, barmerge.lookahead_off)
    htfClose = request.security(syminfo.tickerid, htfTf, close, barmerge.gaps_off, barmerge.lookahead_off)
    htfSwingHigh = request.security(syminfo.tickerid, htfTf, ta.pivothigh(high, swingLen, swingLen), barmerge.gaps_off, barmerge.lookahead_off)
    htfSwingLow = request.security(syminfo.tickerid, htfTf, ta.pivotlow(low, swingLen, swingLen), barmerge.gaps_off, barmerge.lookahead_off)

    var float lastSwingHigh = na
    var float lastSwingLow = na
    if not na(htfSwingHigh)
        lastSwingHigh := htfSwingHigh
    if not na(htfSwingLow)
        lastSwingLow := htfSwingLow

    bullSweep = not na(lastSwingLow) and htfLow < lastSwingLow and htfClose > lastSwingLow
    bearSweep = not na(lastSwingHigh) and htfHigh > lastSwingHigh and htfClose < lastSwingHigh

    var int sweepDir = 0
    var float sweepExtreme = na
    var float sweepLevel = na
    var int sweepBar = na
    if bullSweep and barstate.isconfirmed
        sweepDir := 1
        sweepExtreme := htfLow
        sweepLevel := lastSwingLow
        sweepBar := bar_index
    if bearSweep and barstate.isconfirmed
        sweepDir := -1
        sweepExtreme := htfHigh
        sweepLevel := lastSwingHigh
        sweepBar := bar_index

    sweepFresh = not na(sweepBar) and (bar_index - sweepBar) <= 40 and sweepDir != 0

    // LTF MSS (canonical TF OHLC)
    pivotHigh = ta.pivothigh(high, swingLen, swingLen)
    pivotLow = ta.pivotlow(low, swingLen, swingLen)
    var float lastLH = na
    var float lastHL = na
    if not na(pivotHigh)
        lastLH := pivotHigh
    if not na(pivotLow)
        lastHL := pivotLow

    bullMss = sweepFresh and sweepDir == 1 and not na(lastLH) and close > lastLH and barstate.isconfirmed
    bearMss = sweepFresh and sweepDir == -1 and not na(lastHL) and close < lastHL and barstate.isconfirmed

    var int mssDir = 0
    var int mssBar = na
    if bullMss
        mssDir := 1
        mssBar := bar_index
    if bearMss
        mssDir := -1
        mssBar := bar_index

    mssActive = not na(mssBar) and mssDir == sweepDir and (bar_index - mssBar) <= 24

    avgBody = ta.sma(math.abs(close - open), 14)
    cRange = high - low
    bullDisp = mssActive and mssDir == 1 and close > open and bodyRatio(open, close, high, low) >= minBodyRatio and wickRatio(open, close, high, low) <= maxWickRatio and math.abs(close - open) > avgBody * 1.15 and cRange > atr14 * minDispAtr and (high - close) / math.max(cRange, syminfo.mintick) <= 0.25 and barstate.isconfirmed
    bearDisp = mssActive and mssDir == -1 and close < open and bodyRatio(open, close, high, low) >= minBodyRatio and wickRatio(open, close, high, low) <= maxWickRatio and math.abs(close - open) > avgBody * 1.15 and cRange > atr14 * minDispAtr and (close - low) / math.max(cRange, syminfo.mintick) <= 0.25 and barstate.isconfirmed

    var int dispBar = na
    var int dispDir = 0
    if bullDisp
        dispBar := bar_index
        dispDir := 1
    if bearDisp
        dispBar := bar_index
        dispDir := -1

    dispActive = not na(dispBar) and dispDir == sweepDir and (bar_index - dispBar) <= 18

    bullEngulf = close > open and close[1] < open[1] and close >= math.max(open[1], close[1]) and open <= math.min(open[1], close[1])
    bearEngulf = close < open and close[1] > open[1] and open >= math.max(open[1], close[1]) and close <= math.min(open[1], close[1])
    engulfOk = not requireEngulf or (dispDir == 1 and bullEngulf) or (dispDir == -1 and bearEngulf)

    bullFvg = dispActive and high[2] < low[0] and (low[0] - high[2]) >= atr14 * minGapAtr and barstate.isconfirmed and bar_index > dispBar
    bearFvg = dispActive and low[2] > high[0] and (low[2] - high[0]) >= atr14 * minGapAtr and barstate.isconfirmed and bar_index > dispBar

    var float fvgTop = na
    var float fvgBot = na
    var float fvgCe = na
    var int fvgBar = na
    var int fvgDir = 0
    if bullFvg and engulfOk
        fvgTop := low[0]
        fvgBot := high[2]
        fvgCe := (fvgTop + fvgBot) / 2
        fvgBar := bar_index
        fvgDir := 1
    if bearFvg and engulfOk
        fvgTop := low[2]
        fvgBot := high[0]
        fvgCe := (fvgTop + fvgBot) / 2
        fvgBar := bar_index
        fvgDir := -1

    fvgActive = not na(fvgBar) and fvgDir == sweepDir and (bar_index - fvgBar) <= 10 and bar_index > fvgBar
    c3Doji = math.abs(close - open) / math.max(high - low, syminfo.mintick) <= 0.12

    zoneTop = entryModel == "ce" ? fvgCe + (fvgTop - fvgBot) * 0.08 : entryModel == "upper_half" ? fvgTop : entryModel == "lower_half" ? fvgCe : fvgTop
    zoneBot = entryModel == "ce" ? fvgCe - (fvgTop - fvgBot) * 0.08 : entryModel == "upper_half" ? fvgCe : entryModel == "lower_half" ? fvgBot : fvgBot

    retraceLong = fvgActive and fvgDir == 1 and bar_index > dispBar and low <= zoneTop and high >= zoneBot and close >= fvgBot
    retraceShort = fvgActive and fvgDir == -1 and bar_index > dispBar and low <= zoneTop and high >= zoneBot and close <= fvgTop

    float confPts = 0.0
    if sweepFresh
        confPts += 30
    if mssActive
        confPts += 20
    if dispActive
        confPts += 15
    if fvgActive
        confPts += 15
    if retraceLong or retraceShort
        confPts += 10
    if (fvgDir == 1 and bullEngulf) or (fvgDir == -1 and bearEngulf)
        confPts += 5
    if c3Doji
        confPts += 5

    bool readyLong = false
    bool readyShort = false
    float outEntry = na
    float outSl = na
    float outTp1 = na
    float outTp2 = na
    float outTp3 = na
    float outGapTop = na
    float outGapBot = na
    float outConf = na
    int outSignalTime = na
    int outSlKind = 0

    setupLong = retraceLong and barstate.isconfirmed and confPts >= confThreshold
    setupShort = retraceShort and barstate.isconfirmed and confPts >= confThreshold

    if setupLong
        e = entryModel == "ce" ? fvgCe : close
        [slOk, slCand, slKind, _] = resolveValidStop("long", e, sweepExtreme, fvgTop, fvgBot)
        if not slOk
            if DEBUG_MODE
                log.info("[PIPELINE] SIGNAL_REJECTED_SL_TOO_FAR | direction=long | symbol=" + syminfo.ticker + " | tf=" + timeframe.period + " | entry=" + str.tostring(e, format.mintick) + " | atr=" + str.tostring(nz(atr14, pointSize()), "#.####") + " | maxStopAtrMult=" + str.tostring(maxStopAtrMult, "#.##") + " | maxDist=" + str.tostring(nz(atr14, pointSize()) * maxStopAtrMult, "#.####") + " | kindTried=" + str.tostring(slKind))
        else
            [ee, ssl, t1, t2, t3, _] = calcLevels("long", e, slCand)
            if not rrOk("long", ee, ssl, t1)
                if DEBUG_MODE
                    log.info("[PIPELINE] SIGNAL_REJECTED_RR_TOO_LOW | direction=long | symbol=" + syminfo.ticker + " | tf=" + timeframe.period + " | entry=" + str.tostring(ee, format.mintick) + " | sl=" + str.tostring(ssl, format.mintick) + " | tp1=" + str.tostring(t1, format.mintick) + " | minRr=" + str.tostring(minRr, "#.##"))
            else
                readyLong := true
                outEntry := ee
                outSl := ssl
                outTp1 := t1
                outTp2 := t2
                outTp3 := t3
                outGapTop := fvgTop
                outGapBot := fvgBot
                outConf := confPts / 100.0
                outSignalTime := time
                outSlKind := slKind
                fvgBar := na
                dispBar := na

    if setupShort and not readyLong
        eS = entryModel == "ce" ? fvgCe : close
        [slOkS, slCandS, slKindS, _] = resolveValidStop("short", eS, sweepExtreme, fvgTop, fvgBot)
        if not slOkS
            if DEBUG_MODE
                log.info("[PIPELINE] SIGNAL_REJECTED_SL_TOO_FAR | direction=short | symbol=" + syminfo.ticker + " | tf=" + timeframe.period + " | entry=" + str.tostring(eS, format.mintick) + " | atr=" + str.tostring(nz(atr14, pointSize()), "#.####") + " | maxStopAtrMult=" + str.tostring(maxStopAtrMult, "#.##") + " | maxDist=" + str.tostring(nz(atr14, pointSize()) * maxStopAtrMult, "#.####") + " | kindTried=" + str.tostring(slKindS))
        else
            [eeS, sslS, t1S, t2S, t3S, _] = calcLevels("short", eS, slCandS)
            if not rrOk("short", eeS, sslS, t1S)
                if DEBUG_MODE
                    log.info("[PIPELINE] SIGNAL_REJECTED_RR_TOO_LOW | direction=short | symbol=" + syminfo.ticker + " | tf=" + timeframe.period + " | entry=" + str.tostring(eeS, format.mintick) + " | sl=" + str.tostring(sslS, format.mintick) + " | tp1=" + str.tostring(t1S, format.mintick) + " | minRr=" + str.tostring(minRr, "#.##"))
            else
                readyShort := true
                outEntry := eeS
                outSl := sslS
                outTp1 := t1S
                outTp2 := t2S
                outTp3 := t3S
                outGapTop := fvgTop
                outGapBot := fvgBot
                outConf := confPts / 100.0
                outSignalTime := time
                outSlKind := slKindS
                fvgBar := na
                dispBar := na

    [readyLong, readyShort, outEntry, outSl, outTp1, outTp2, outTp3, outGapTop, outGapBot, outConf, outSignalTime, outSlKind]


