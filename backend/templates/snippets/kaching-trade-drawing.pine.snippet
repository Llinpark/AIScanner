// ===== TRADE DRAWING ENGINE (shared) =====
// Persistence contract: once a trade is confirmed/drawn it MUST remain until
// TP3, SL, configurable candle expiry, or explicit cancel — NEVER because a
// later setup scan fails or lines run out of fixed bar length.
//
// Pine v5/v6 HARD RULE: user functions MUST NOT modify global variables
// (no := / += on globals, and no array.push/set/clear on global arrays).
// Helpers below are PURE. All global mutations live in main-scope `if` blocks.

// Drawing collections — mutated ONLY in main-scope blocks below.
var array<line> tradeLevelLines = array.new_line()
var array<label> tradeLevelLabels = array.new_label()
var array<line> tradeLeaderLines = array.new_line()
var array<label> tradeBadgeHold = array.new_label()
var array<box> tradeFvgHold = array.new_box()

// Float state: [entry, sl, tp1, tp2, tp3, gapTop, gapBot]
var array<float> tradeFloats = array.new_float(7, na)
// String state: [direction, signalId]
var array<string> tradeStrings = array.new_string(2, "")
// Int flags: [active(0/1), entryBar, tp1Alerted(0/1), tp2Alerted(0/1)]
var array<int> tradeFlags = array.new_int(4, 0)

// ----- pure getters (read-only) -----
tradeIsActive() =>
    array.get(tradeFlags, 0) == 1

tradeEntry() =>
    array.get(tradeFloats, 0)

tradeSl() =>
    array.get(tradeFloats, 1)

tradeTp1() =>
    array.get(tradeFloats, 2)

tradeTp2() =>
    array.get(tradeFloats, 3)

tradeTp3() =>
    array.get(tradeFloats, 4)

tradeGapTop() =>
    array.get(tradeFloats, 5)

tradeGapBot() =>
    array.get(tradeFloats, 6)

tradeDirection() =>
    array.get(tradeStrings, 0)

tradeSignalId() =>
    array.get(tradeStrings, 1)

tradeEntryBar() =>
    array.get(tradeFlags, 1)

tradeTp1Alerted() =>
    array.get(tradeFlags, 2) == 1

tradeTp2Alerted() =>
    array.get(tradeFlags, 3) == 1

smartLabelGapPrice() =>
    math.max(syminfo.mintick * smartLabelMinVerticalTicks, syminfo.mintick)

smartLabelOffsetBars(int step) =>
    math.max(minHorizontalGapBars * step, 1)

makeSignalId() =>
    str.upper(syminfo.ticker) + "-" + str.tostring(time) + "-" + str.tostring(bar_index)

// Pure layout helper — only mutates local arrays it creates.
resolveLabelLayout(array<float> anchors) =>
    count = array.size(anchors)
    layoutY = array.new_float(count, na)
    layoutSide = array.new_int(count, 1)
    layoutStep = array.new_int(count, 0)
    gapPrice = smartLabelGapPrice()
    for idx = 0 to count - 1
        anchor = array.get(anchors, idx)
        y = anchor
        rightConflicts = 0
        if idx > 0
            for prev = 0 to idx - 1
                prevY = array.get(layoutY, prev)
                if math.abs(y - prevY) < gapPrice
                    moveUp = y >= prevY or anchor == prevY
                    y := prevY + (moveUp ? gapPrice : -gapPrice)
                    rightConflicts := rightConflicts + 1
        spillLeft = rightConflicts >= 2 and idx >= 2
        if spillLeft
            y := anchor
            if idx > 0
                for prev = 0 to idx - 1
                    prevY = array.get(layoutY, prev)
                    prevSide = array.get(layoutSide, prev)
                    if prevSide == -1 and math.abs(y - prevY) < gapPrice
                        moveUpLeft = y >= prevY or anchor == prevY
                        y := prevY + (moveUpLeft ? gapPrice : -gapPrice)
            array.set(layoutSide, idx, -1)
        array.set(layoutY, idx, y)
        array.set(layoutStep, idx, rightConflicts)
    [layoutY, layoutSide, layoutStep]

// Pure: create one level's drawings and return them.
buildSmartLevel(int x1, int x2, float anchorPrice, float labelPrice, string tag, color lineCol, color bgCol, color txtCol, bool placeRight, int stackStep) =>
    levelLine = line.new(x1, anchorPrice, x2, anchorPrice, xloc=xloc.bar_index, extend=extend.none, color=lineCol, width=2, style=line.style_solid)
    labelAnchorX = placeRight ? x2 + smartLabelOffsetBars(stackStep + 1) : x1 - smartLabelOffsetBars(stackStep + 1)
    labelStyle = placeRight ? label.style_label_left : label.style_label_right
    leaderStartX = placeRight ? x2 : x1
    leaderLine = line.new(leaderStartX, anchorPrice, labelAnchorX, labelPrice, xloc=xloc.bar_index, extend=extend.none, color=color.new(lineCol, 20), width=1, style=line.style_dotted)
    levelLabel = label.new(labelAnchorX, labelPrice, tag + "  " + formatPrice(anchorPrice), xloc=xloc.bar_index, yloc=yloc.price, style=labelStyle, color=bgCol, textcolor=txtCol, size=size.normal)
    [levelLine, leaderLine, levelLabel]

// Pure: build all five trade levels into LOCAL arrays and return them.
buildTradeDrawings(float entryPrice, float slPrice, float tp1Price, float tp2Price, float tp3Price, bool isLong) =>
    x1 = bar_index
    x2 = bar_index + math.max(levelExtendBars, 1)
    anchorPrices = array.from(entryPrice, slPrice, tp1Price, tp2Price, tp3Price)
    tags = array.from(isLong ? "Buy" : "Sell", "SL", "TP1", "TP2", "TP3")
    lineColors = array.from(isLong ? colBuy : colSell, isLong ? colSlBuy : colSlSell, colTpNear, colTpNear, colTpFar)
    bgColors = array.from(isLong ? colBuy : colSell, isLong ? colSlBuy : colSlSell, colTpNear, colTpNear, colTpFar)
    textColors = array.from(color.white, color.white, color.white, color.white, color.white)
    [layoutY, layoutSide, layoutStep] = resolveLabelLayout(anchorPrices)
    outLines = array.new_line()
    outLeaders = array.new_line()
    outLabels = array.new_label()
    for idx = 0 to array.size(anchorPrices) - 1
        [lvl, leader, lbl] = buildSmartLevel(
             x1,
             x2,
             array.get(anchorPrices, idx),
             array.get(layoutY, idx),
             array.get(tags, idx),
             array.get(lineColors, idx),
             array.get(bgColors, idx),
             array.get(textColors, idx),
             array.get(layoutSide, idx) == 1,
             array.get(layoutStep, idx)
         )
        array.push(outLines, lvl)
        array.push(outLeaders, leader)
        array.push(outLabels, lbl)
    [outLines, outLeaders, outLabels]

// ===================== MAIN-SCOPE: active trade lifecycle =====================
if tradeIsActive() and barstate.isconfirmed
    longTrade = tradeDirection() == "long"
    barsAlive = bar_index - tradeEntryBar()
    hitSlWick = longTrade ? low <= tradeSl() : high >= tradeSl()
    hitTp3Wick = longTrade ? high >= tradeTp3() : low <= tradeTp3()
    hitTp2 = longTrade ? high >= tradeTp2() : low <= tradeTp2()
    hitTp1 = longTrade ? high >= tradeTp1() : low <= tradeTp1()
    // Same-bar SL+TP3: resolve by close (not wick alone).
    hitSl = hitSlWick and hitTp3Wick ? (longTrade ? close <= tradeSl() : close >= tradeSl()) : hitSlWick
    hitTp3 = hitSlWick and hitTp3Wick ? (longTrade ? close >= tradeTp3() : close <= tradeTp3()) : hitTp3Wick
    expired = enableTradeExpiry and barsAlive >= expiryBars
    closeNow = hitSl or hitTp3 or expired
    closeAlertType = hitSl ? "stop_loss" : hitTp3 ? "take_profit_3" : "expired"
    closeReason = hitSl ? "sl" : hitTp3 ? "tp3" : "candle_expiry"

    if closeNow
        if str.length(tradeSignalId()) > 0
            closeMsg = buildPayload(closeAlertType, tradeDirection(), tradeEntry(), tradeSl(), tradeTp1(), tradeTp2(), tradeTp3(), nz(tradeGapTop(), tradeEntry()), nz(tradeGapBot(), tradeEntry()), 0.0, tradeSignalId(), closeReason)
            alert(closeMsg, alert.freq_once_per_bar)
        if array.size(tradeLevelLines) > 0
            for i = 0 to array.size(tradeLevelLines) - 1
                line.delete(array.get(tradeLevelLines, i))
        if array.size(tradeLeaderLines) > 0
            for i = 0 to array.size(tradeLeaderLines) - 1
                line.delete(array.get(tradeLeaderLines, i))
        if array.size(tradeLevelLabels) > 0
            for i = 0 to array.size(tradeLevelLabels) - 1
                label.delete(array.get(tradeLevelLabels, i))
        array.clear(tradeLevelLines)
        array.clear(tradeLeaderLines)
        array.clear(tradeLevelLabels)
        if array.size(tradeBadgeHold) > 0
            label.delete(array.get(tradeBadgeHold, 0))
            array.clear(tradeBadgeHold)
        if array.size(tradeFvgHold) > 0
            box.delete(array.get(tradeFvgHold, 0))
            array.clear(tradeFvgHold)
        array.set(tradeFloats, 0, na)
        array.set(tradeFloats, 1, na)
        array.set(tradeFloats, 2, na)
        array.set(tradeFloats, 3, na)
        array.set(tradeFloats, 4, na)
        array.set(tradeFloats, 5, na)
        array.set(tradeFloats, 6, na)
        array.set(tradeStrings, 0, "")
        array.set(tradeStrings, 1, "")
        array.set(tradeFlags, 0, 0)
        array.set(tradeFlags, 1, 0)
        array.set(tradeFlags, 2, 0)
        array.set(tradeFlags, 3, 0)
    else
        if hitTp1 and not tradeTp1Alerted()
            msgTp1 = buildPayload("take_profit_1", tradeDirection(), tradeEntry(), tradeSl(), tradeTp1(), tradeTp2(), tradeTp3(), nz(tradeGapTop(), tradeEntry()), nz(tradeGapBot(), tradeEntry()), 0.0, tradeSignalId(), "tp1")
            alert(msgTp1, alert.freq_once_per_bar)
            array.set(tradeFlags, 2, 1)
            if array.size(tradeBadgeHold) > 0
                label.set_text(array.get(tradeBadgeHold, 0), longTrade ? "Kaching Buy · TP1" : "Kaching Sell · TP1")
        if hitTp2 and not tradeTp2Alerted()
            msgTp2 = buildPayload("take_profit_2", tradeDirection(), tradeEntry(), tradeSl(), tradeTp1(), tradeTp2(), tradeTp3(), nz(tradeGapTop(), tradeEntry()), nz(tradeGapBot(), tradeEntry()), 0.0, tradeSignalId(), "tp2")
            alert(msgTp2, alert.freq_once_per_bar)
            array.set(tradeFlags, 3, 1)
            if array.size(tradeBadgeHold) > 0
                label.set_text(array.get(tradeBadgeHold, 0), longTrade ? "Kaching Buy · TP2" : "Kaching Sell · TP2")
        // Keep overlays glued to the live bar while trade remains open.
        rightX = bar_index + 1
        if array.size(tradeLevelLines) > 0
            for i = 0 to array.size(tradeLevelLines) - 1
                line.set_x2(array.get(tradeLevelLines, i), rightX)
        if array.size(tradeLeaderLines) > 0
            for i = 0 to array.size(tradeLeaderLines) - 1
                line.set_x2(array.get(tradeLeaderLines, i), rightX + smartLabelOffsetBars(i + 1))
        if array.size(tradeLevelLabels) > 0
            for i = 0 to array.size(tradeLevelLabels) - 1
                label.set_x(array.get(tradeLevelLabels, i), rightX + smartLabelOffsetBars(i + 1))
        if array.size(tradeBadgeHold) > 0
            label.set_x(array.get(tradeBadgeHold, 0), bar_index)
