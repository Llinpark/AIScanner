# LOCAL REAL-INTEGRATION canary — NOT cloud staging, NOT production.
# Copy to .env.local-canary (gitignored). Never copy production secrets.
# Database name MUST be kaching_local_canary.

NODE_ENV=development
PORT=4010
LOCAL_INTEGRATION_CANARY=true
LOCAL_INTEGRATION_CONFIRM_ISOLATED=true
LOCAL_INTEGRATION_TELEGRAM_ENABLED=false
LOCAL_INTEGRATION_EMAIL_ENABLED=false

PUBLIC_BACKEND_URL=http://127.0.0.1:4010
FRONTEND_URL=http://127.0.0.1:5173
APP_DOMAIN=localhost

MONGODB_URI=mongodb://127.0.0.1:27017/kaching_local_canary
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Generate unique local secrets: node scripts/generate-staging-secrets.js
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=
TRADINGVIEW_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Optional real test bot/chat. Leave disabled unless you have a dedicated TEST bot.
TELEGRAM_BOT_TOKEN=
STAGING_TELEGRAM_CHAT_ID=
STAGING_TELEGRAM_DENY_CHAT_IDS=

# Optional real test mailbox via SMTP2GO.
SMTP2GO_API_KEY=<set-in-runtime-secret-store>
EMAIL_FROM=
STAGING_EMAIL_TO=
STAGING_EMAIL_DENY_RECIPIENTS=
EMAIL_TRADE_ALERTS_ENABLED=true
