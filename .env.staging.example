# Isolated STAGING environment contract.
# Copy to .env.staging (never commit). Fill EVERY required value.
# NEVER copy values from kaching-api / production Fly secrets.
# Placeholder or empty secrets fail closed. This file does not deploy anything.

NODE_ENV=staging
PORT=4010

# Fly staging app name. Must never be kaching-api.
FLY_APP=kaching-api-staging

# Operator must set these to true only after isolated resources exist.
STAGING_CONFIRM_ISOLATED=false
STAGING_MONGO_SOAK=false
STAGING_TELEGRAM_ENABLED=false
STAGING_EMAIL_ENABLED=false

# Staging API hostname — operator-provided after `fly apps create kaching-api-staging`.
# Default Fly hostname (if you keep it): https://kaching-api-staging.fly.dev
# Custom domains are optional and operator-provided. Never use:
#   https://api.kachingscanner.com
#   https://kaching-api.fly.dev
PUBLIC_BACKEND_URL=
FRONTEND_URL=
APP_DOMAIN=

# Dedicated staging MongoDB. Path MUST end with /kaching_staging
# Example shape (not a real host): mongodb+srv://USER:PASS@HOST/kaching_staging
MONGODB_URI=

# Dedicated staging Redis. Never production Upstash/Redis.
# Example shape (not a real host): rediss://default:TOKEN@HOST:6379
REDIS_URL=
REDIS_ENABLED=true

# Unique STAGING secrets. Generate with: node scripts/generate-staging-secrets.js
# Never copy WEBHOOK_SIGNING_SECRET or TRADINGVIEW_WEBHOOK_SECRET from production.
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=
TRADINGVIEW_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Staging Telegram: dedicated TEST bot + ONE test chat. Never a subscriber chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STAGING_TELEGRAM_CHAT_ID=
# Comma-separated known subscriber/production chat IDs the canary must refuse
STAGING_TELEGRAM_DENY_CHAT_IDS=

# Staging Email: dedicated TEST mailbox via SMTP2GO.
SMTP2GO_API_KEY=<set-in-runtime-secret-store>
SMTP2GO_TIMEOUT_MS=15000
EMAIL_FROM=
EMAIL_TRADE_ALERTS_ENABLED=true
STAGING_EMAIL_TO=
# Comma-separated known subscriber addresses the canary must refuse
STAGING_EMAIL_DENY_RECIPIENTS=

# Extra production host denylist (comma-separated hostnames)
STAGING_PRODUCTION_HOSTS=

# Optional: set true only if kaching_staging already has non-canary users you accept
# STAGING_ALLOW_EXISTING_USERS=false

# Sequence wait (defaults match application code)
# SEQUENCE_WAIT_UNHEALTHY_MS=60000
# SEQUENCE_WAIT_MAX_MS=600000
# DELIVERY_SEQ_WAIT_MS=3000
