# FastAPI AI analytics — market candles come from Node (request body or shared Redis).
# Do NOT set TWELVE_DATA_API_KEY / EODHD_API_KEY here; those belong in backend/.env only.

# Shared Redis (same instance as Node MarketDataHubService writes)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# Optional local TTL metadata (reads use Node hub keys: kaching:candles:*)
MARKET_DATA_CACHE_TTL_SECONDS=300
MARKET_DATA_STALE_CACHE_SECONDS=900
