# Copy to a local file (e.g. fly-secrets.local.env), fill values from backend/.env,
# then run:  Get-Content fly-secrets.local.env | fly secrets import --app kaching-api
# Do NOT commit files containing real secrets.

MONGODB_URI=
REDIS_URL=
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Required for production webhook mode (startup setWebhook). Keep TELEGRAM_USE_POLLING=false on Fly.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KachingAIBot
TRADINGVIEW_WEBHOOK_SECRET=
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
# FastAPI AI analytics (Fly app kaching-python; Node injects candles)
PYTHON_SERVICE_URL=https://kaching-python.fly.dev
PYTHON_SERVICE_API_KEY=
APP_DOMAIN=kachingscanner.com
FRONTEND_URL=https://kachingscanner.com
PUBLIC_BACKEND_URL=https://api.kachingscanner.com
COOKIE_DOMAIN=.kachingscanner.com
PAYMENTS_MODE=live
ADMIN_EMAILS=collinspark1985@gmail.com,barasajohn1985@gmail.com,lilianmonari15@gmail.com
SUPER_ADMIN_EMAILS=collinspark1985@gmail.com
REDIS_ENABLED=true
# Do NOT set MT5_PAIRING_ALLOW_MEMORY in production — PairCode requires Redis.
TELEGRAM_USE_POLLING=false
SCANNER_AUTO_ENABLED=true
SCALPING_STRATEGY_ENABLED=true
# Email (Resend HTTPS API). SMTP_* already live on Fly; keep them in future imports.
# SMTP_PASS should be the Resend API key (re_...) when SMTP_HOST=smtp.resend.com.
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=KachingScanner <noreply@kachingscanner.com>
# Trade-alert emails live in fly.toml [env], not as a Fly secret (secrets override [env]).
# EMAIL_TRADE_ALERTS_ENABLED=true
BETA_MODE=true
BETA_TIER=premium
BETA_ACCESS_DAYS=30
